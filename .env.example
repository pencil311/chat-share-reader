# Bearer tokens for the MCP endpoint. Comma-separated so you can rotate, or
# hand a different one to each person. Leave unset to keep the endpoint open
# (rate limiting still applies). Setting this is the recommended default — see
# "Running it safely" in the README.
# MCP_AUTH_TOKEN=generate-a-long-random-string

# Shared store for rate-limit counters and the share-page cache. Without these,
# counters are per serverless instance, so a distributed caller can slip past
# the limit. Plain REST over fetch, so it also works on Cloudflare Workers.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
