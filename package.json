{
  "name": "chat-share-reader",
  "version": "0.1.0",
  "description": "MCP server + CLI that reads public ChatGPT share links into structured transcripts any AI can consume, plus a browser bookmarklet for Claude share links (which no server can fetch).",
  "type": "module",
  "bin": {
    "chat-share-reader": "dist/src/cli.js"
  },
  "main": "dist/src/extract.js",
  "types": "dist/src/extract.d.ts",
  "files": [
    "dist",
    "bookmarklet",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "stdio": "tsx src/cli.ts --stdio",
    "test": "npm run test:parsers && npm run test:bookmarklet",
    "test:parsers": "tsx test/parsers.test.ts",
    "test:bookmarklet": "node bookmarklet/build.js && node bookmarklet/test/export.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "claude",
    "share-link",
    "transcript",
    "parser"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
